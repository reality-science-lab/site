---
import siteConfig from '../../astro.config.mjs';
import '../styles/news.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  article?: boolean;
}
const { title, description, ogImage, article = false } = Astro.props;
const origin = process.env.SITE_ORIGIN || siteConfig.site;
const base = process.env.BASE_PATH || '';
const canonical = `${origin}${base}${Astro.url.pathname}`;
const image = ogImage
  ? (/^https?:\/\//.test(ogImage) ? ogImage : `${origin}${base}${ogImage}`)
  : undefined;
const links = [
  ['/#editing', '現実編集'], ['/#mission', 'ミッション'],
  ['/#portfolio', 'プロジェクト'], ['/#values', 'バリュー'],
  ['/lecture/', 'レクチャー'], ['/news/', 'ニュース'],
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=JetBrains+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Old+Mincho:wght@500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="nav">
      <a class="nav__brand" href="/">現実科学研究所</a>
      <nav class="nav__links" aria-label="メインナビゲーション">
        {links.map(([href, label]) => <a href={href} aria-current={href === '/news/' ? (article ? 'location' : 'page') : undefined}>{label}</a>)}
      </nav>
      <a class="nav__cta" href="/#join">お問い合わせ</a>
    </header>
    <main id="main" class="news-main"><slot /></main>
    <footer class="foot">
      <div class="foot__brand">現実科学研究所<span>REALITY SCIENCE INSTITUTE</span></div>
      <nav class="foot__nav" aria-label="セクション索引">
        {links.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/#join">仲間募集</a>
        <a href="/manifest/">趣意書</a>
      </nav>
      <div class="foot__base">© 2026 RSI</div>
    </footer>
  </body>
</html>
